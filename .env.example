# Copy this file to .env and adjust the values.
# development | testing | production
APP_ENV=development
SECRET_KEY=change-me
# Relative SQLite paths are created inside instance/
DATABASE_URL=sqlite:///credits.db
# Comma-separated origins allowed to call /api/* from another domain (empty = none)
CORS_ORIGINS=

# ---------- Production server (python serve.py) ----------
# Address and port Waitress listens on; keep 127.0.0.1 when a reverse proxy runs on the same machine
HOST=127.0.0.1
PORT=8000
THREADS=8
# IP of the reverse proxy that terminates HTTPS (empty = no proxy headers are trusted)
TRUSTED_PROXY=
