# Copy this file to .env and adjust the values.
# development | testing | production
APP_ENV=development
SECRET_KEY=change-me
# Relative SQLite paths are created inside instance/
DATABASE_URL=sqlite:///credits.db
# Business time zone (IANA name): decides what "today" is for dates, standings and due dates
APP_TIMEZONE=America/Mexico_City

# ---------- Logs ----------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Empty = console; a file name rotates at 5 MB keeping 5 copies (relative paths are created inside instance/)
LOG_FILE=

# ---------- Backups ----------
# Folder for database copies (relative paths are created inside instance/)
BACKUP_DIR=backups
# How many copies to keep; older ones are deleted
BACKUP_KEEP=30
# python serve.py copies the database at start-up and then every this many hours (0 = off)
BACKUP_INTERVAL_HOURS=24

# ---------- Production server (python serve.py) ----------
# Address and port Waitress listens on; keep 127.0.0.1 when a reverse proxy runs on the same machine
HOST=127.0.0.1
PORT=8000
THREADS=8
# IP of the reverse proxy that terminates HTTPS (empty = no proxy headers are trusted)
TRUSTED_PROXY=
